pipeline {
    agent any

    environment {
        DOCKER_HUB_USER = 'phor2026'
        IMAGE_NAME      = 'usea-app-html'
        EC2_IP          = '52.63.116.240'
        EC2_USER        = 'ubuntu'
        APP_PORT        = '9098'
    }

    stages {
        stage('1. Checkout Code') {
            steps {
                echo "📥 Pulling latest code from GitHub..."
                checkout scm
            }
        }

        stage('2. Build HTML Docker Image') {
            steps {
                dir('html') {
                    echo "🔨 Building HTML Image: ${DOCKER_HUB_USER}/${IMAGE_NAME}:${BUILD_NUMBER}..."
                    sh "docker build -t ${DOCKER_HUB_USER}/${IMAGE_NAME}:${BUILD_NUMBER} -t ${DOCKER_HUB_USER}/${IMAGE_NAME}:latest ."
                }
            }
        }

        stage('3. Test Nginx Configuration') {
            steps {
                echo "🧪 Testing Nginx Configuration..."
                sh "docker run --rm --entrypoint nginx ${DOCKER_HUB_USER}/${IMAGE_NAME}:latest -t"
                echo "✅ Nginx syntax check passed!"
            }
        }

        stage('4. Push to Docker Hub') {
            steps {
                echo "🚀 Logging in and Pushing Image to Docker Hub..."
                withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials', usernameVariable: 'DH_USER', passwordVariable: 'DH_PASS')]) {
                    sh 'echo "$DH_PASS" | docker login -u "$DH_USER" --password-stdin'
                    sh "docker push ${DOCKER_HUB_USER}/${IMAGE_NAME}:${BUILD_NUMBER}"
                    sh "docker push ${DOCKER_HUB_USER}/${IMAGE_NAME}:latest"
                }
                echo "🎉 HTML Image pushed to Docker Hub successfully!"
            }
        }

        stage('5. Deploy to AWS EC2') {
            steps {
                echo "🚢 Connecting via SSH to AWS EC2 (${EC2_IP}) and Deploying HTML Container..."
                sshagent(['ec2-server-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_IP} "
                            docker pull ${DOCKER_HUB_USER}/${IMAGE_NAME}:latest && \\
                            docker stop ${IMAGE_NAME} || true && \\
                            docker rm ${IMAGE_NAME} || true && \\
                            docker run -d --name ${IMAGE_NAME} --restart always -p ${APP_PORT}:80 ${DOCKER_HUB_USER}/${IMAGE_NAME}:latest && \\
                            docker image prune -f
                        "
                    """
                }
                echo "🎉 Deployed HTML App to AWS EC2 successfully! Check at http://${EC2_IP}:${APP_PORT}"
            }
        }
    }

    post {
        always {
            sh "docker logout || true"
        }
        success {
            echo "🟢 ========================================================="
            echo "🟢 HTML CI/CD PIPELINE & DEPLOY TO AWS EC2 SUCCEEDED 100%!"
            echo "🟢 HTML App Running on AWS: http://${EC2_IP}:${APP_PORT}"
            echo "🟢 Docker Hub: https://hub.docker.com/r/${DOCKER_HUB_USER}/${IMAGE_NAME}"
            echo "🟢 ========================================================="
        }
        failure {
            echo "🔴 HTML Pipeline failed. Please check logs."
        }
    }
}
