pipeline {
    agent any

    environment {
        DOCKER_HUB_USER = 'phor2026'
        IMAGE_NAME      = 'usea-app-php'
        EC2_IP          = '52.63.116.240'
        EC2_USER        = 'ubuntu'
        APP_PORT        = '9099'
    }

    stages {
        stage('1. Checkout Code') {
            steps {
                echo "📥 Pulling latest code from GitHub..."
                checkout scm
            }
        }

        stage('2. Build PHP Docker Image') {
            steps {
                dir('php') {
                    echo "🔨 Building PHP Image: ${DOCKER_HUB_USER}/${IMAGE_NAME}:${BUILD_NUMBER}..."
                    sh "docker build -t ${DOCKER_HUB_USER}/${IMAGE_NAME}:${BUILD_NUMBER} -t ${DOCKER_HUB_USER}/${IMAGE_NAME}:latest ."
                }
            }
        }

        stage('3. Test PHP Syntax') {
            steps {
                echo "🧪 Testing PHP Syntax..."
                sh "docker run --rm --entrypoint php ${DOCKER_HUB_USER}/${IMAGE_NAME}:latest -l /var/www/html/index.php"
                echo "✅ PHP Syntax check passed!"
            }
        }

        stage('4. Push to Docker Hub') {
            steps {
                echo "🚀 Logging in and Pushing Image to Docker Hub..."
                withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials', usernameVariable: 'DH_USER', passwordVariable: 'DH_PASS')]) {
                    sh 'echo "$DH_PASS" | docker login -u "$DH_USER" --password-stdin'
                    sh "docker push ${DOCKER_HUB_USER}/${IMAGE_NAME}:${BUILD_NUMBER}"
                    sh "docker push ${DOCKER_HUB_USER}/${IMAGE_NAME}:latest"
                }
                echo "🎉 PHP Image pushed to Docker Hub successfully!"
            }
        }

        stage('5. Deploy to AWS EC2') {
            steps {
                echo "🚢 Connecting via SSH to AWS EC2 (${EC2_IP}) and Deploying PHP Container..."
                sshagent(['ec2-server-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_IP} "
                            sudo apt-get clean || true
                            sudo journalctl --vacuum-size=50M || true
                            docker ps -q --filter publish=${APP_PORT} | xargs -r docker rm -f || true
                            docker rm -f ${IMAGE_NAME} jenkins-demo-app || true
                            docker system prune -af || true
                            docker pull ${DOCKER_HUB_USER}/${IMAGE_NAME}:latest
                            docker run -d --name ${IMAGE_NAME} --restart always -p ${APP_PORT}:80 ${DOCKER_HUB_USER}/${IMAGE_NAME}:latest
                        "
                    """
                }
                echo "🎉 Deployed PHP App to AWS EC2 successfully! Check at http://${EC2_IP}:${APP_PORT}"
            }
        }
    }

    post {
        always {
            sh "docker logout || true"
        }
        success {
            echo "🟢 ========================================================="
            echo "🟢 PHP CI/CD PIPELINE & DEPLOY TO AWS EC2 SUCCEEDED 100%!"
            echo "🟢 PHP App Running on AWS: http://${EC2_IP}:${APP_PORT}"
            echo "🟢 Docker Hub: https://hub.docker.com/r/${DOCKER_HUB_USER}/${IMAGE_NAME}"
            echo "🟢 ========================================================="
        }
        failure {
            echo "🔴 PHP Pipeline failed. Please check logs."
        }
    }
}
